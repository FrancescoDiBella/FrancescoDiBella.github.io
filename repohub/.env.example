# RepoHub — configurazione. Copia questo file in `.env` (che NON va mai committato) e compila.
# Valori con spazi: scrivili tra virgolette oppure così come sono. Le righe che iniziano con # sono commenti.

# Token personale di GitHub. Facoltativo per i dati pubblici, necessario per i repository privati,
# per alzare il limite da 60 a 5000 richieste l'ora e per mettere/togliere stelle dall'app.
# Consigliato un "fine-grained token" (github.com/settings/personal-access-tokens) con:
#   Repository access: tutti i tuoi repository (o quelli che vuoi vedere)
#   Permessi repository (sola lettura): Metadata, Contents, Issues, Pull requests, Actions
#   Permessi account: Starring (lettura e scrittura) per le stelle
GITHUB_TOKEN=

# Utente di cui mostrare i repository. Se lo lasci vuoto si usa il proprietario del token.
GITHUB_USER=

# API REST. Cambiala solo per GitHub Enterprise Server: https://tuo-host/api/v3
GITHUB_API_URL=https://api.github.com

# Nome mostrato in alto nella barra laterale.
REPOHUB_TITLE=RepoHub

# Tema: system, light oppure dark.
REPOHUB_THEME=system

# Repository nella sezione "Fissati", separati da virgole (nome o proprietario/nome).
# Vuoto: i tre aggiornati più di recente.
REPOHUB_PINNED=

# Includere fork e repository archiviati.
REPOHUB_INCLUDE_FORKS=true
REPOHUB_INCLUDE_ARCHIVED=false

# Quanti repository leggere al massimo.
REPOHUB_MAX_REPOS=100

# Da quanti repository (i più recenti) leggere esecuzioni di Actions e commit settimanali.
# Ognuno costa 2 richieste API a ogni aggiornamento.
REPOHUB_ACTIVITY_REPOS=5

# true per mostrare i dati di esempio anche con un token configurato.
REPOHUB_DEMO=false
